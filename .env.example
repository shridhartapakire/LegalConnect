# Application
ENVIRONMENT=development
DEBUG=true
# Required in production. Use a unique, long random value.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Leave empty for local SQLite development. Production must set a PostgreSQL URL.
# Example: postgresql://legalconnect:change-me@localhost:5432/legalconnect
DATABASE_URL=

# Local development prints email to the terminal. Set SMTP values only when needed.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@legalconnect.local
